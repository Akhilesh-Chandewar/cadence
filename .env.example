# Cadence LLM setup (spec §7.7) — copy to `.env` and fill in the key for your provider.
# `.env` is gitignored; never commit real keys.

# --- hosted providers (set ONE) ---
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=
#GROQ_API_KEY=
#OPENROUTER_API_KEY=
#MISTRAL_API_KEY=
#DEEPSEEK_API_KEY=

# --- local models need no key ---
# provider: ollama, model: llama3.1 (run `ollama serve` first)

# --- optional overrides (defaults live in cadence/config/default_config.py) ---
#CADENCE_LLM_PROVIDER=openai
#CADENCE_LLM_MODEL=gpt-4o-mini
#CADENCE_LLM_API_KEY_ENV=OPENAI_API_KEY
